APP_NAME="AI Fishing Concierge API"
APP_VERSION="0.1.0"
TIMEZONE="Asia/Jerusalem"

# Public read-only CSV published from Google Sheets.
PUBLIC_REPORTS_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vRRGkYir-70KmoWwNkSV0zPulvDF97p9A7xb1prqNuqMk70B9_fPobp532gumbpO5OsdJ-ZSqtiq_zt/pub?output=csv"

# Required only for POST /report.
# Use the spreadsheet ID from the editable Google Sheet URL, not the published CSV URL.
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Лист1"

# Option A: local file path for development.
GOOGLE_SERVICE_ACCOUNT_FILE=""

# Option B: JSON string for Render environment variables.
# Paste the full service account JSON as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=""

OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_MARINE_URL="https://marine-api.open-meteo.com/v1/marine"
REQUEST_TIMEOUT_SECONDS=15
CORS_ORIGINS="*"
